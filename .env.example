# Lobuddy TypeScript development configuration
# Copy to .env and fill locally. Never commit actual credentials.
# Packaged applications use the protected settings entry, not this file.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=

# Fish Audio: selected voice and free/paid tier are controlled in voice settings.
FISH_API_KEY=
# Jev is independent from the chat model; enable shadow/active only when desired.
TYPESAFE_API_KEY=
# JEV_MODE=off
# JEV_MODEL=jev-1.13.0
# JEV_MIN_CONFIDENCE=0.75
# JEV_DAILY_CALLS=30
# JEV_DAILY_REQUEST_BYTES=60000

# Current image requests use the configured DSH model, which must support images.
# Legacy multimodal fields remain readable for data compatibility, not a second agent.
# PET_NAME=Lobuddy
# USER_NAME=
# TASK_TIMEOUT=120
# SHELL_ENABLED=false
# HITL_APPROVAL_TIMEOUT_SECONDS=120
# FOCUS_DEFAULT_MINUTES=25
# FOCUS_BREAK_MINUTES=5
# FOCUS_AUTO_LOOP=false
# MEMORY_ENABLE_MIGRATION=true
# MEMORY_SESSION_SEARCH_ENABLED=true
# MEMORY_SESSION_SEARCH_ALLOW_CROSS_SESSION=false
# MEMORY_LINT_ENABLED=true

# Learning, companionship, voice model download and scheduling policies have
# dedicated application settings. Data/workspace locations belong to Electron;
# generic settings cannot redirect them. Tests use explicit isolated launch paths.
